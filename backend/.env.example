PORT=8080
DATABASE_URL=postgres://postgres:PASSWORD@genesis-db:5432/genesis

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tienda-genesis.example.com/api/auth/google/callback

# Random 32+ byte secret, e.g. `openssl rand -hex 32`
SESSION_COOKIE_SECRET=
# Cookie is only sent over HTTPS in production
COOKIE_SECURE=true

MERCADOPAGO_ACCESS_TOKEN=
RESEND_API_KEY=

# Random 32+ byte secret used to sign private-file URLs
FILE_SIGNING_SECRET=

# Where uploaded files are stored on disk (a Coolify persistent volume mount)
STORAGE_DIR=/data/storage

# Public origin of this API, used to build absolute file URLs
PUBLIC_ORIGIN=https://tienda-genesis.example.com

FRONTEND_ORIGIN=https://tienda-genesis.example.com
